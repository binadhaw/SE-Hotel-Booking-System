# Copy this file to src/main/resources/secrets.properties and fill in your own values.
# That file is ignored by git, so your secrets never end up on GitHub.

# Your local MySQL password
spring.datasource.password=change-me

# 32-byte AES key in Base64 for encrypting personal data. Generate one with:
#   openssl rand -base64 32
# (or in PowerShell: [Convert]::ToBase64String((1..32 | ForEach-Object { Get-Random -Maximum 256 })))
# Every teammate can use their own key for their own local database.
app.crypto.key=PASTE-YOUR-BASE64-KEY-HERE

# Optional: real email sending (see application.properties)
# app.mail.enabled=true
# spring.mail.host=smtp.gmail.com
# spring.mail.port=587
# spring.mail.username=you@gmail.com
# spring.mail.password=your-app-password
